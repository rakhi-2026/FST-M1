            <class name="Activities.Activity5"/>
        </classes>
    </test>
    <test name="ExcludeHeaderTests">
		<groups>
			<run>
				<exclude name="HeaderTests"/>
			</run>
		</groups>
        <classes>
            <class name="Activities.Activity5"/>
        </classes>
    </test>
</suite>