<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd" >
<suite name="softwaretestingmaterial">
	<test name="AllTests">
		<classes>
            <class name="Activities.Activity5"/>
        </classes>
    </test>
    <test name="ButtonTests">
		<groups>
			<run>
				<include name="ButtonTests"/>
			</run>
		</groups>
        <classes>
            <class name="Activities.Activity5"/>
